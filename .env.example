# Puerto del servidor (Por defecto en Render u otras plataformas gratuitas)
PORT=3000

# API Key de Google Gemini (Obténla gratis en Google AI Studio)
GEMINI_API_KEY=tu_api_key_aqui

# Configuración de Correo SMTP (Para enviar los leads a la cuenta principal)
# Ejemplo con Gmail: usa tu correo y una "App Password" (Contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo_de_envio@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion

# Correo de Destino (Donde recibirás los datos de los clientes)
DESTINATION_EMAIL=creditoinfonavit@asinmex.mx
